# ============================================================================
# PocketSmart AI — Environment Configuration Example
# ============================================================================

# Database Configuration (PostgreSQL)
# e.g., postgresql://username:password@localhost:5432/pocketsmart
DATABASE_URL=

# Google Gemini API
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Security & Authentication
# 256-bit secret key for HMAC-SHA256 JWT signing
JWT_SECRET=pocketsmart-secure-auth-signing-key-2026-sha256

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_SENSITIVE_MAX=20

# Application Base URL
APP_URL=http://localhost:3000

# Optional Provider Integration Keys (Leave blank for AI_SUGGESTION mode)
GOOGLE_PLACES_API_KEY=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_PAAPI_REGION=eu-west-1
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
IKEA_PARTNER_API_KEY=
IKEA_PARTNER_ENDPOINT=
SWIGGY_PARTNER_API_KEY=
SWIGGY_PARTNER_ENDPOINT=
ZOMATO_PARTNER_API_KEY=
ZOMATO_PARTNER_ENDPOINT=
TANISHQ_PARTNER_API_KEY=
TANISHQ_PARTNER_ENDPOINT=
CARATLANE_PARTNER_API_KEY=
CARATLANE_PARTNER_ENDPOINT=
